# SPDX-License-Identifier: GPL-3.0-or-later
# Interface 00 is the Ryuo screen HID. The interface and USB device are
# different parents in sysfs, so evaluate their attributes in separate rules.
SUBSYSTEM=="hidraw", ATTRS{bInterfaceNumber}=="00", ENV{.RYUO_IFACE}="1"
# Firmware 1.0.3/1.0.10 uses ASUSTek 0b05 and 1.0.7 uses Baiyi 1c75.
# Preserve local-seat HID access before systemd's 73-seat-late.rules.
SUBSYSTEM=="hidraw", ENV{.RYUO_IFACE}=="1", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1c76", GROUP="ryuo-screen", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ENV{.RYUO_IFACE}=="1", ATTRS{idVendor}=="1c75", ATTRS{idProduct}=="1c76", GROUP="ryuo-screen", MODE="0660", TAG+="uaccess"
# ADB opens the USB device node. usbfs permissions apply to the whole
# matching composite device. The hidraw grant above is interface-specific.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0b05", ATTR{idProduct}=="1c76", GROUP="ryuo-screen", MODE="0660"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1c75", ATTR{idProduct}=="1c76", GROUP="ryuo-screen", MODE="0660"
